# -*- coding: utf-8; mode: tcl; tab-width: 4; indent-tabs-mode: nil; c-basic-offset: 4 -*- vim:fenc=utf-8:ft=tcl:et:sw=4:ts=4:sts=4

PortSystem          1.0
PortGroup           github 1.0
PortGroup           xcode 1.0

github.setup        GStreamer cerbero 1.26.0
revision            0

name                gstreamer.framework
categories          multimedia
maintainers         {@Gcenx}
description         GStreamer is a streaming media framework
long_description    {*}${description}
supported_archs     arm64 x86_64
platforms           {darwin >= 17}
license             LGPL-2+
homepage            https://gstreamer.freedesktop.org

fetch.type          git
use_configure       no

post-fetch {
    system -W ${worksrcpath} "git submodule update --init"
    reinplace -q "/variants.override/d"  ${worksrcpath}/config/darwin.config
    system -W ${worksrcpath} "${worksrcpath}/cerbero-uninstalled fetch-bootstrap"
    system -W ${worksrcpath} "${worksrcpath}/cerbero-uninstalled fetch"
}

pre-build {
    reinplace -q "/variants.override/d"  ${worksrcpath}/config/darwin.config
}

build {
    system -W ${worksrcpath} "${worksrcpath}/cerbero-uninstalled bootstrap --offline"
    system -W ${worksrcpath} "${worksrcpath}/cerbero-uninstalled build-deps --offline"
    system -W ${worksrcpath} "${worksrcpath}/cerbero-uninstalled build --offline gstreamer-1.0"
}

destroot {
    system -W ${worksrcpath} "${worksrcpath}/cerbero-uninstalled package --offline gstreamer-1.0"
}
