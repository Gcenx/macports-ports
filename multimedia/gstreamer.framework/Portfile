fetch.type          git

post-fetch {
    system -W ${worksrcpath} "git submodule update --init --recursive"
}

#configure.dir
configure.cmd ${worksrcpath}/cerbero-uninstalled

configure.args -c config/cross-macos-x86-64.cbc bootstrap

